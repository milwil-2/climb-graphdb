# ── Neo4j Aura ────────────────────────────────────────────────────────────────
# Connection URI for your Aura instance (neo4j+s:// for encrypted).
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io

# NOTE: Aura username is the INSTANCE ID, not the string "neo4j".
NEO4J_USER=<instance-id>

# Aura instance password (generated at instance creation time).
NEO4J_PASSWORD=

# ── Upstream Supabase (READ-ONLY) ─────────────────────────────────────────────
# MUST be a READ-ONLY role on the climbing-elo Supabase DB.
# Never use the postgres superuser or a role with write privileges here.
DATABASE_URL=postgresql://<readonly_user>:<pw>@<host>.pooler.supabase.com:5432/postgres

# ── LLM / enrichment ─────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Ingest endpoint guard ─────────────────────────────────────────────────────
# Local-only bearer token protecting /ingest.
# When this variable is UNSET in the cloud environment, the /ingest route is
# automatically disabled (fail-safe default).
INGEST_API_KEY=

# ── News enrichment ───────────────────────────────────────────────────────────
NEWS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:8000

# ── MVP cohort slice (optional, default OFF) ──────────────────────────────────
# Restrict every source read to a small, coherent slice: the N most-active men +
# women who competed this season AND in a prior season, plus the FULL field of
# every event they entered within a recent-season window. Lets the whole pipeline
# run cheaply. A per-run `--cohort/--no-cohort` CLI flag overrides COHORT_ENABLED.
COHORT_ENABLED=false
# Athletes per gender to keep (default 50 → ~100 cohort athletes).
COHORT_SIZE_PER_GENDER=50
# Recent-season window width in seasons (default 4 → e.g. 2023–2026).
COHORT_SEASON_WINDOW=4
# "This season" anchor; leave unset to auto-detect as max(events.season).
COHORT_CURRENT_SEASON=
